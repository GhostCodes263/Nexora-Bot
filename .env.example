OPENAI_API_KEY=
TELEGRAM_PAYMENT_PROVIDER=
PAYMENT_CONFIGURATION=
PUBLIC_CHANNEL_ID=
VIP_CHANNEL_ID=

ENVIRONMENT=production
LOG_LEVEL=INFO
